# ========================================================
# OZON-DEZ Environment Configuration Template
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to source control!
# ========================================================

# Public Website URL (Canonical)
PUBLIC_SITE_URL=https://ozon-dez.com.ua

# Telegram Lead Notifications & Bot
# Token obtained from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Admin Telegram Chat ID for receiving leads
TELEGRAM_ADMIN_CHAT_ID=341806822

# Public Contact Details
PUBLIC_CONTACT_PHONE=+380636672653
PUBLIC_CONTACT_CITY_PHONE=0486860308
PUBLIC_OFFICE_ADDRESS=м. Чорноморськ, просп. Миру, 8-А

# Cloudflare Deployment (Optional for serverless bot webhook)
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
